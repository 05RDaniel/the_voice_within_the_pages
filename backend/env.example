# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=your-secret-key
NODE_ENV=development

# Email - Resend (recomendado en producción/Render; evita el bloqueo de puertos SMTP)
# Si se define, tiene prioridad sobre la configuración SMTP de abajo.
RESEND_API_KEY=

# Email (Hostinger SMTP - SSL/TLS) - usado si no hay RESEND_API_KEY
# Sin estas variables el registro funcionará pero no se enviarán correos.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-email@tudominio.com
SMTP_PASS=tu-contraseña-de-email
# Opcional: remitente visible (por defecto usa SMTP_USER)
EMAIL_FROM=tu-email@tudominio.com
